# build temp: build-bundle.js writes beside the bundle and renames into place,
# so a *.building file is a build that did not finish
*.building

# OS
Thumbs.db
desktop.ini
.DS_Store

# playwright, installed for browser verification only
node_modules/
package-lock.json

# native/: the store apps. www/ is generated by tools/build-native.js from the
# deploy bundle, and the platforms copy it into their own public folders on
# every sync, so none of the three copies is source. The lockfile IS source:
# it pins what the shell was built with.
native/www/
!native/package-lock.json
