# --- Server (read by server/index.ts via dotenv; copy to .env) ---

# Port the API + production static server listens on.
PORT=8787

# Secret for session JWT signing. REQUIRED in production; a dev default is
# used (with a warning) when unset.
JWT_SECRET=change-me-to-a-long-random-string

# OpenAI-compatible API used by the horoscope + relocation oracles
# (replaces Floot AI / gpt-6-luna). Without a key the oracle endpoints
# return the same "temporarily unavailable" error the Floot app shows
# when out of credits.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Stripe (Codex Luminary). Without STRIPE_SECRET_KEY the premium page shows
# "Payments are being set up" and the paywall stays closed for everyone.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Comma-separated emails that get the admin role on registration
# (admins bypass the Luminary paywall, as in the Floot app).
CODEX_ADMIN_EMAILS=

# --- Frontend (Vite; copy to .env too — VITE_* vars are public) ---

# Set to "true" only after wiring a standalone OAuth flow (see README).
VITE_ENABLE_OAUTH=false
